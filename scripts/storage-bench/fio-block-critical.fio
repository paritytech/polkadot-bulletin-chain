# fio pre-screen for the block-critical IO of a Bulletin node.
# Emulates, per 6 s block, the storage work that gates block production, run against a large
# (cold) file so the proof read is a true random read into the retention set.
#
# Usage:
#   sudo TARGET=/mnt/data/bench fio scripts/storage-bench/fio-block-critical.fio
# Set SIZE to your retention footprint (default 1700g). Needs SIZE + ~100g free on TARGET.
# Compare across NVMe / capacity-flash / HDD. Budget: block-critical latencies (state, proof)
# must sit well inside the block time while the sync-serve read (below) saturates the tier.

[global]
directory=${TARGET}
size=${SIZE:-1700g}
ioengine=libaio
direct=1
runtime=300
time_based=1
group_reporting=1
# Report the percentiles that matter for the block-time budget.
percentile_list=50:95:99:99.9

# ParityDB state access: small random read/write, low queue depth, latency-sensitive.
# State is tiny under --state-pruning=1000, so a small file, not the retention set.
[state-random]
rw=randrw
rwmixread=70
bs=4k
iodepth=4
numjobs=2
size=50g

# New blob data written to columns::TRANSACTION: ~8 MiB per block, sequential.
# 8 MiB / 6 s ~= 1.33 MiB/s sustained; the burst is what matters, so write in 8 MiB chunks.
[blob-write]
filename=blob-set
rw=write
bs=1m
iodepth=8
numjobs=1
rate=1398101
# ^ 8 MiB per 6 s in bytes/s; 2 s blocks = 4194304, 500 ms = 16777216.

# Proof challenge: one random read of a few KB from anywhere in the retention set, per block
# (rate_iops=1 is ~6x the 6 s block rate, deliberately conservative). The proof's target block
# is deterministic (now - RetentionPeriod), so the node can prefetch it - this is a floor, not
# the real risk (that's sync-serve, below). Shares the blob file so reads hit the written set.
[proof-random-read]
filename=blob-set
rw=randread
bs=16k
iodepth=1
numjobs=1
rate_iops=1

# Serving syncing peers: THE read that matters. A peer catching up pulls historical bodies, so
# this is high-volume concurrent random reads across the whole retention set - the load a cheap
# tier (especially HDD) is most likely to fail, and what the go/no-go hinges on. No rate cap:
# measure sustained random-read throughput (bw) and p99 clat, and check it does not push the
# block-critical jobs above (state, proof) past the block-time budget.
[sync-serve-random-read]
filename=blob-set
rw=randread
bs=256k
iodepth=32
numjobs=4
